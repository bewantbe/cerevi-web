{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "types": ["vite/client", "bun-types", "node", "@webgpu/types"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "paths": {
      "@/*": ["./src/*"],
      "galavi": ["../../galavi/src/index.ts"],
      "galavi/ome-zarr": ["../../galavi/src/dataset/adapters/ome-zarr.ts"]
    }
  }
}